NODE_ENV=development
PORT=3002
TZ=America/Campo_Grande

# Postgres
DB_USER=__set_me__
DB_PASS=__set_me__
DB_NAME=cobrix_db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SCHEMA=public

# JWT — gere um segredo forte e único (obrigatório em produção):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# O boot em produção FALHA se estiver ausente ou for o valor placeholder abaixo.
JWT_SECRET=change-me-dev-secret

# Criptografia das credenciais de gateway em repouso (AES-256-GCM). Obrigatório.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_SECRET=__set_me__

# Seed do master (usado apenas se nenhum master existir)
MASTER_EMAIL=admin@example.com
MASTER_PASSWORD=__set_me__

# WhatsApp (Evolution API)
EVO_API_URL=https://evo.example.com
EVO_API_KEY=__set_me__

# CORS — origens permitidas separadas por vírgula (use HTTPS em produção)
ALLOWED_ORIGINS=http://localhost:5173

# URL pública do sistema (usada para montar a URL do webhook PIX)
APP_URL=http://localhost:3002

# PIX / EFI
PIX_CHAVE=__set_me__
# Secret do webhook PIX — OBRIGATÓRIO (sem ele o webhook é rejeitado).
#   node -e "console.log(require('crypto').randomUUID())"
# Depois registre na EFI via: POST /api/webhooks/register/:companyId
EFI_WEBHOOK_SECRET=__set_me__
# Polling de fallback para reconciliação de pagamentos (ms).
GATEWAY_POLL_MS=300000

# Crons (deixe vazio para desabilitar um job)
CRON_TZ=America/Campo_Grande
CRON_PRE=0 8 * * *
CRON_GENERATE=10 8 * * *
CRON_DUE=20 8 * * *
CRON_LATE=30 8 * * *
CRON_RENEW=0 7 * * *
CRON_RETRY=*/30 * * * *

# Retry de notificações WhatsApp
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_WINDOW_HOURS=48

# Nível de log: trace | debug | info | warn | error
LOG_LEVEL=info

# Pool do Postgres
DB_POOL_MAX=20
DB_POOL_CONN_TIMEOUT_MS=10000
# DB_SSL=true   # habilite se o Postgres exigir SSL

# Alerta operacional (opcional): webhook para onde erros de cron são enviados
# (compatível com Slack/Discord/n8n/Zapier). Vazio = desabilitado.
ALERT_WEBHOOK_URL=

# Row-Level Security no banco (opcional, avançado). Só habilite após seguir o
# RUNBOOK.md (role não-owner + FORCE RLS + ajuste dos crons). Padrão: desligado.
ENABLE_RLS=false
